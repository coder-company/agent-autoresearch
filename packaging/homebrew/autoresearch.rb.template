class Autoresearch < Formula
  desc "Autonomous goal-directed iteration engine for coding agents"
  homepage "https://github.com/coder-company/agent-autoresearch"
  version "VERSION"
  license "GPL-2.0-only"

  on_macos do
    on_arm do
      url "https://github.com/coder-company/agent-autoresearch/releases/download/v#{version}/autoresearch-v#{version}-aarch64-apple-darwin.tar.gz"
      sha256 "SHA256_MACOS_AARCH64"
    end

    on_intel do
      url "https://github.com/coder-company/agent-autoresearch/releases/download/v#{version}/autoresearch-v#{version}-x86_64-apple-darwin.tar.gz"
      sha256 "SHA256_MACOS_X86_64"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/coder-company/agent-autoresearch/releases/download/v#{version}/autoresearch-v#{version}-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "SHA256_LINUX_AARCH64"
    end

    on_intel do
      url "https://github.com/coder-company/agent-autoresearch/releases/download/v#{version}/autoresearch-v#{version}-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "SHA256_LINUX_X86_64"
    end
  end

  def install
    bin.install "autoresearch"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/autoresearch --version")
  end
end
