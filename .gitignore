# Build artifacts
target/

# Binary is built per-platform — ship via GitHub Releases or install.sh.
# Keep the portable hook wrapper tracked; ignore other generated bin artifacts.
bin/*
!bin/
!bin/autoresearch

# Reference repos (not shipped)
ref/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Autoresearch runtime artifacts (generated during use)
autoresearch-results/
